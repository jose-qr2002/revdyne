{
  "name": "tiktok-gift-keys",
  "version": "1.0.0",
  "description": "TikTok Live Gift to Keypress - Similar a TikFinity",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "node server.js",
    "install-robot": "npm install robotjs --build-from-source",
    "pack": "electron-builder --win"
  },
  "dependencies": {
    "@jitsi/robotjs": "^0.6.13",
    "express": "^4.18.2",
    "node-fetch": "^3.3.2",
    "socket.io": "^4.6.1",
    "tiktok-live-connector": "^1.1.7"
  },
  "devDependencies": {
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
      "appId": "com.reveljk.tiktokl4d2",
      "productName": "TikTok Keyboard Controller",
      "asar": true,
      "asarUnpack": [
        "config.json"
      ],
      "directories": {
        "output": "release"
      },
      "files": [
        "main.js",
        "server.js",
        "config.json",
        "routes/**/*",
        "services/**/*",
        "config/**/*",
        "frontend/dist/**/*",
        "node_modules/**/*"
      ],
      "win": {
        "target": ["dir"]
      }
    }
}
