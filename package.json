{
  "name": "revdyne",
  "version": "1.0.0-beta.11",
  "description": "TikTok Live Gift to Keypress - Similar a TikFinity",
  "author": "JK REVIL",
  "license": "UNLICENSED",
  "icon": "build/icon.ico",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "node server.js",
    "install-robot": "npm install robotjs --build-from-source",
    "build:frontend": "cd frontend && npm run build",
    "dist": "npm run build:frontend && electron-builder --win --publish never"
  },
  "dependencies": {
    "@jitsi/robotjs": "^0.6.22",
    "adm-zip": "^0.6.1",
    "electron-updater": "^6.8.9",
    "express": "^4.18.2",
    "multer": "^2.2.0",
    "node-edge-tts": "^1.2.10",
    "node-fetch": "^3.3.2",
    "node-machine-id": "^1.1.12",
    "socket.io": "^4.6.1",
    "tiktok-live-connector": "^2.4.0"
  },
  "devDependencies": {
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "javascript-obfuscator": "^5.4.1"
  },
  "build": {
    "appId": "com.jkrevil.revdyne",
    "productName": "Revdyne",
    "copyright": "Copyright © 2026 JK REVIL",
    "asar": false,
    "afterPack": "./proteger.js",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!frontend/src/**/*",
      "!frontend/node_modules/**/*",
      "!release/**/*",
      "!proteger.js",
      "!ofuscar.js"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Revdyne",
      "artifactName": "Revdyne-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.reveljk.com/win/"
      }
    ]
  }
}
