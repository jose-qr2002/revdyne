{
  "name": "tiktok-gift-keys",
  "version": "1.0.0",
  "description": "TikTok Live Gift to Keypress - Similar a TikFinity",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "node server.js",
    "install-robot": "npm install robotjs --build-from-source",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "node proteger.js",
    "pack": "npm run build:frontend && npm run build:backend && electron-builder --win"
  },
  "dependencies": {
    "@jitsi/robotjs": "^0.6.13",
    "express": "^4.18.2",
    "node-fetch": "^3.3.2",
    "socket.io": "^4.6.1",
    "tiktok-live-connector": "^2.1.1-beta1"
  },
  "devDependencies": {
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "javascript-obfuscator": "^5.4.1"
  },
  "build": {
    "appId": "com.tu-nombre.tiktokl4d2",
    "productName": "TikTok L4D2 Controller",
    "asar": false,
    "extraMetadata": {
      "main": "dist-backend/main.js"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-backend/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "dir"
      ]
    }
  }
}
